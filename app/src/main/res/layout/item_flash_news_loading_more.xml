<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/loadingMarkOne"
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:background="@color/flash_red" />

        <View
            android:id="@+id/loadingMarkTwo"
            android:layout_width="3dp"
            android:layout_height="16dp"
            android:layout_marginStart="3dp"
            android:background="@color/flash_red" />

        <View
            android:id="@+id/loadingMarkThree"
            android:layout_width="3dp"
            android:layout_height="10dp"
            android:layout_marginStart="3dp"
            android:background="@color/flash_red" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:text="@string/flash_loading_more_stories"
        android:textAllCaps="true"
        android:textColor="@color/flash_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
