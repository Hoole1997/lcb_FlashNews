<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flash_page_bg">

    <TextView
        android:id="@+id/settingTitle"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="@string/flash_settings_title"
        android:textColor="@color/flash_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/settingsList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="18dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingTitle">

        <include
            android:id="@+id/languageRow"
            layout="@layout/item_flash_setting_value" />

        <include
            android:id="@+id/privacyRow"
            layout="@layout/item_flash_setting_plain" />

        <include
            android:id="@+id/feedbackRow"
            layout="@layout/item_flash_setting_plain" />

        <include
            android:id="@+id/aboutRow"
            layout="@layout/item_flash_setting_value" />

        <FrameLayout
            android:id="@+id/meNativeAdContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
